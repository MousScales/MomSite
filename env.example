# ════════════════════════════════════════════════════════════════
#  VERCEL ENVIRONMENT VARIABLES — Maya African Hair Braiding
#  Vercel → Project → Settings → Environment Variables
#  Add each name + value as a separate variable. No quotes around values.
#  After adding/changing any variable → Redeploy.
# ════════════════════════════════════════════════════════════════

# ── Stripe (Payments) ────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Supabase (Database) ──────────────────────────────────────────
# Get from https://supabase.com → Project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Resend (Confirmation Emails) ─────────────────────────────────
# Get from https://resend.com/api-keys
# RESEND_FROM format: "Name <email@yourdomain.com>"
RESEND_API_KEY=re_...
RESEND_FROM=Maya African Hair Braiding <bookings@yourdomain.com>

# ── Twilio (WhatsApp Notifications) ──────────────────────────────
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Twilio WhatsApp sender (sandbox: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated list of numbers that receive booking alerts
OWNER_WHATSAPP_TO=whatsapp:+18604250751,whatsapp:+18603675091,whatsapp:+12037100568

# ── Cal.com (Calendar Sync) ───────────────────────────────────────
# 1. Go to https://app.cal.com/settings/developer/api-keys → create a key
# 2. Create an event type called "Hair Appointment"
# 3. Edit that event type — the URL will show: app.cal.com/event-types/123456
#    That number is your CAL_COM_EVENT_TYPE_ID
CAL_COM_API_KEY=cal_live_...
CAL_COM_EVENT_TYPE_ID=123456

# ── Sync Secret (one-time backfill protection) ────────────────────
# Any password you choose — used to protect /api/sync-calcom-bookings
SYNC_SECRET=your_secret_here

# ── Google Calendar (optional) ────────────────────────────────────
# Service account credentials for Google Calendar event creation
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
